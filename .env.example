# ═══════════════════════════════════════════════════════════════
# HURMO UZ DASHBOARD — Environment Variables Template
# Copy this file to .env.local and fill in real values
# ═══════════════════════════════════════════════════════════════

# ── AUTHENTICATION ──────────────────────────────────────────────
# Password for dashboard login page
DASHBOARD_PASSWORD="change_me_in_production"

# JWT signing secret — must be at least 32 random characters
# Generate: openssl rand -hex 32
JWT_SECRET="generate_secure_random_64_character_hex_secret"

# ── GOOGLE SHEETS — Table IDs ────────────────────────────────────
# Extract from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
GOOGLE_SHEET_MAIN=""
GOOGLE_SHEET_NUMBERS=""
GOOGLE_SHEET_ESKIZ=""
GOOGLE_SHEET_NOT_COMPLETED=""

# ── GOOGLE CLOUD SERVICE ACCOUNT ────────────────────────────────
# Service account must have Viewer access to all 4 sheets above
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# ── GEMINI AI API ────────────────────────────────────────────────
# Get free key at: https://aistudio.google.com/apikey
# Used for: /api/ai-chat and /api/ai-insights endpoints
GEMINI_API_KEY=""

# ── OPTIONAL: TELEGRAM NOTIFICATIONS ────────────────────────────
# Uncomment and fill to enable Telegram anomaly alerts
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""

# ── OPTIONAL: CACHING ────────────────────────────────────────────
# Cache TTL in seconds (default: 300 = 5 minutes)
# CACHE_TTL_SECONDS=300
